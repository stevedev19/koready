{
  "version": 1,
  "notes": "Patterns are case-insensitive JavaScript regular expressions. Korean (ko) patterns are matched against the message with all spaces removed, so write them without spaces. 'any' patterns are language-neutral (links). A rule counts once no matter how many of its patterns match.",
  "scoring": {
    "likely_scam_min_score": 5,
    "reassurance_min_chars": 40,
    "reassurance_min_letter_ratio": 0.5
  },
  "rules": [
    {
      "id": "delivery_notice",
      "category": "delivery",
      "weight": 2,
      "patterns": {
        "en": [
          "\\b(parcel|package|delivery|shipment)\\b.{0,60}\\b(address (is )?(incorrect|wrong|incomplete|invalid)|unable to deliver|failed|on hold|held|suspended|could not be delivered|couldn't be delivered)\\b",
          "\\bcustoms (fee|duty|charge|clearance)\\b",
          "\\b(re-?delivery|redeliver)\\b",
          "\\b(update|confirm|verify) (your )?(delivery |shipping )?address\\b"
        ],
        "ko": [
          "주소지?(불명|오류|불일치|미확인|미기재|재확인)",
          "주소.{0,4}확인.{0,6}(부탁|바랍|요망|필요|해주세요)",
          "배송.{0,10}(불가|실패|보류|중단|지연안내)",
          "반송(예정|처리|됩니다)",
          "통관.{0,6}(보류|비용|수수료|정보확인|번호확인)"
        ]
      },
      "explanation": {
        "en": "Says a delivery failed or needs your address or a fee. Fake parcel notices are one of the most common scam texts in Korea. Check in the courier's official app instead of tapping links."
      },
      "needs_native_review": true
    },
    {
      "id": "bank_card_loan",
      "category": "bank_card_loan",
      "weight": 2,
      "patterns": {
        "en": [
          "\\b(low|special|government|govt)[- ]?(interest|rate|support(ed)?)\\b.{0,40}\\bloans?\\b",
          "\\bloans?\\b.{0,40}\\b(approved|pre-?approved|limit|eligible|no credit check|guaranteed)\\b",
          "\\b(card|account)\\b.{0,40}\\b(suspended|locked|blocked|frozen|restricted)\\b",
          "\\b(overseas|international|foreign) (payment|purchase|transaction)\\b.{0,60}\\b(if (this|it) (was not|wasn't) you|call|contact|report)\\b",
          "\\bif (this|it) (was not|wasn't) you\\b.{0,40}\\b(call|contact|click|tap)\\b"
        ],
        "ko": [
          "저금리",
          "대환대출",
          "정부지원.{0,6}(대출|자금)",
          "대출.{0,10}(승인|가능|한도|대상자|신청하세요)",
          "(카드|계좌).{0,10}(정지|잠금|차단|동결|제한)(되었|됩니다|예정|처리)",
          "해외.{0,6}(결제|승인).{0,30}(문의|신고|본인아닐|아닐경우|아니시면)",
          "본인이?아닐경우|본인이?아니시면|본인(결제|사용)이?아닐"
        ]
      },
      "explanation": {
        "en": "Offers a loan or warns about a payment or a blocked card or account. Scammers use these to get you to call them or tap a link. Call the number on the back of your card or in your bank's app."
      },
      "needs_native_review": true
    },
    {
      "id": "authority_impersonation",
      "category": "authority",
      "weight": 3,
      "patterns": {
        "en": [
          "\\b(prosecutor'?s? office|public prosecutor|prosecution service|prosecutors?)\\b",
          "\\byour (account|name|bank account|identity|bankbook)\\b.{0,60}\\b(crime|criminal|money laundering|fraud|investigation|case|illegal)\\b",
          "\\b(arrest warrant|summons|subpoena|court order)\\b",
          "\\b(financial supervisory service|FSS) (officer|investigator|staff)\\b",
          "\\b(cyber|police) (investigation|investigator|detective) (team|unit|division)?\\b.{0,60}\\b(your|you)\\b"
        ],
        "ko": [
          "검찰",
          "지검|중앙지검|지방검찰",
          "수사관",
          "금융감독원|금감원",
          "대포통장|자금세탁|명의도용",
          "사건.{0,6}(연루|관련자|피의자)",
          "구속영장|체포영장|출석요구|소환장"
        ]
      },
      "explanation": {
        "en": "Claims to be the police, the prosecutor's office (검찰) or a financial regulator. Real officials never ask for money, transfers or app installs by phone or text."
      },
      "needs_native_review": true
    },
    {
      "id": "immigration_impersonation",
      "category": "immigration",
      "weight": 3,
      "patterns": {
        "en": [
          "\\b(immigration (office|service|officer)|hikorea)\\b.{0,80}\\b(cancel(l)?ed|revoked|suspended|deport(ed|ation)?|fine|penalty|illegal|overstay|violation)\\b",
          "\\b(visa|residence card|ARC|alien registration)\\b.{0,60}\\b(cancel(l)?ed|revoked|suspended|invalid|illegal|blocked)\\b",
          "\\bdeport(ed|ation)\\b"
        ],
        "ko": [
          "출입국.{0,12}(취소|정지|위반|벌금|과태료|강제)",
          "체류.{0,8}(취소|정지|위반|불법)",
          "강제(출국|퇴거)",
          "비자.{0,6}(취소|정지|무효)",
          "외국인등록.{0,6}(취소|정지|말소|무효)"
        ]
      },
      "explanation": {
        "en": "Threatens your visa, residence status or deportation. The immigration office doesn't settle fines or cancel visas by text. Check on HiKorea or call 1345."
      },
      "needs_native_review": true
    },
    {
      "id": "safe_account",
      "category": "safe_account",
      "weight": 5,
      "patterns": {
        "en": [
          "\\bsafe(ty)? (bank )?account\\b",
          "\\b(secure|protected|protection|government) account\\b",
          "\\btransfer (your|all|the) (money|funds|balance|savings)\\b.{0,60}\\b(protect|safe|secure|investigation|temporar(y|ily))\\b",
          "\\b(withdraw|take out) (the )?(cash|money)\\b.{0,60}\\b(hand (it )?over|give (it )?to|deliver|officer|agent|keep it safe)\\b"
        ],
        "ko": [
          "안전계좌",
          "보호계좌",
          "국가안전",
          "(현금|돈).{0,8}(인출|찾아).{0,20}(전달|맡기|맡겨|보관)",
          "자산.{0,6}(보호|이전)"
        ]
      },
      "explanation": {
        "en": "Asks you to move money to a \"safe account\" (안전계좌) or hand over cash. No government agency or bank ever does this. It's always a scam."
      },
      "needs_native_review": true
    },
    {
      "id": "family_emergency",
      "category": "family_emergency",
      "weight": 3,
      "patterns": {
        "en": [
          "\\b(mom|mum|dad|mother|father)\\b.{0,60}\\b(new (phone|number)|phone (broke|is broken)|screen (broke|is broken|cracked)|lost my phone|borrowed (a|my friend's|someone's) phone)\\b",
          "\\b(phone|screen) (is )?(broke|broken|cracked)\\b.{0,80}\\b(can'?t|cannot) (call|talk)\\b",
          "\\b(gift ?cards?|google play cards?|itunes cards?)\\b",
          "\\b(this is my new number|texting from (a|my) (new|friend's) (phone|number))\\b"
        ],
        "ko": [
          "(엄마|아빠|어머니|아버지).{0,20}(폰|핸드폰|휴대폰|액정).{0,10}(고장|깨|망가|수리|맡겼)",
          "(폰|핸드폰|휴대폰|액정).{0,6}(고장|깨져|깨졌|수리맡)",
          "(폰|핸드폰|휴대폰|액정).{0,20}통화.{0,4}(안돼|안되|불가|못해)",
          "문화상품권|기프트카드|구글카드|구글플레이카드",
          "(신분증|주민등록증).{0,10}(사진|찍어)"
        ]
      },
      "explanation": {
        "en": "Sounds like a family member with a \"broken phone\" asking for help. A classic scam (\"Mom, my phone broke\"). Call the person on their usual number before you send anything."
      },
      "needs_native_review": true
    },
    {
      "id": "sensitive_info_request",
      "category": "sensitive_info",
      "weight": 4,
      "patterns": {
        "en": [
          "(?<!\\b(?:not|never|n't)\\s+(?:\\w+\\s+){0,2})\\b(send|enter|provide|confirm|verify|tell|share|give|text|upload)\\b.{0,40}\\b(ARC|alien registration|residence card|passport|OTP|one[- ]time (password|code)|verification code|security card|PIN|password|card number|CVC|CVV|resident registration|bank login)\\b(?!\\W{0,5}\\d)",
          "\\b(photo|picture|copy|scan) of (your )?(ARC|passport|ID|residence card|bank card|credit card)\\b"
        ],
        "ko": [
          "(외국인등록증|외국인등록번호|여권|OTP|보안카드|비밀번호|카드번호|주민등록번호|주민번호|신분증|계좌비밀번호).{0,15}(보내|입력|알려(?!주지마|지마)|전송|촬영|찍어)",
          "인증번호(?!\\W{0,5}\\d).{0,15}(보내|알려(?!주지마|지마)|불러|전달)"
        ]
      },
      "explanation": {
        "en": "Asks for your ARC, passport, OTP, verification code, PIN or card details. Real companies never ask you to send these by message. Never share a verification code with anyone."
      },
      "needs_native_review": true
    },
    {
      "id": "link_shortener",
      "category": "link",
      "weight": 3,
      "patterns": {
        "any": [
          "\\b(bit\\.ly|tinyurl\\.com|t\\.ly|is\\.gd|cutt\\.ly|rebrand\\.ly|shorturl\\.at|me2\\.kr|han\\.gl|url\\.kr|vo\\.la|buly\\.kr|c11\\.kr|zrr\\.kr|t\\.co|goo\\.su|qrco\\.de)/"
        ]
      },
      "explanation": {
        "en": "Has a shortened link that hides where it really goes. Scam texts often use these. Open the company's official app or website yourself instead."
      },
      "needs_native_review": true
    },
    {
      "id": "link_odd",
      "category": "link",
      "weight": 3,
      "patterns": {
        "any": [
          "https?://\\d{1,3}(\\.\\d{1,3}){3}",
          "\\b[a-z0-9-]+\\.(xyz|top|icu|cc|vip|shop|click|live|buzz|cyou|monster|rest|sbs|cfd|bond|lol|tk|ml|ga|cf|gq|work|support|life|info)\\b",
          "\\b(hikorea|epost|coupang|naver|kakao|cjlogistics|kbstar|shinhan|woori|hana|nonghyup|toss|kbank)[-_][a-z0-9-]*\\.",
          "\\.apk\\b"
        ]
      },
      "explanation": {
        "en": "Has a link with an unusual web address, such as an odd ending, a bare number, or a brand name with extra words. Scam sites copy real brands this way. A .apk link installs an app, which can steal your data."
      },
      "needs_native_review": true
    },
    {
      "id": "link_any",
      "category": "link",
      "weight": 1,
      "patterns": {
        "any": [
          "https?://",
          "\\bwww\\.",
          "\\b[a-z0-9-]+\\.(com|net|org|kr|co\\.kr|me|io|ly|link)/"
        ]
      },
      "explanation": {
        "en": "Has a link. Links aren't bad on their own, but if the message was unexpected, open the company's official app or website yourself instead."
      },
      "needs_native_review": true
    },
    {
      "id": "remote_app_install",
      "category": "link",
      "weight": 4,
      "patterns": {
        "en": [
          "\\b(install|download)\\b.{0,30}\\b(this |the |our |security |remote )?(app|apk|application|program)\\b.{0,40}\\b(link|below|here|to (check|verify|protect|track|confirm))\\b",
          "\\b(teamviewer|anydesk|remote (access|control|support))\\b"
        ],
        "ko": [
          "(앱|어플|프로그램).{0,6}(설치|다운).{0,10}(해주세요|하세요|하시면|후)",
          "팀뷰어|애니데스크|원격(제어|지원|조종)"
        ]
      },
      "explanation": {
        "en": "Asks you to install an app or allow remote access. Scammers use these apps to read your texts and take over your phone and bank apps."
      },
      "needs_native_review": true
    },
    {
      "id": "urgency_threats",
      "category": "urgency",
      "weight": 2,
      "patterns": {
        "en": [
          "\\b(urgent(ly)?|immediately|asap|within (24|48|12) hours|today only|final (notice|warning)|last (chance|warning)|act now)\\b",
          "\\b(will|may|could) be (suspended|blocked|arrested|deported|fined|charged|frozen|cancel(l)?ed|closed|prosecuted|seized)\\b",
          "\\b(legal action|penalty fee|late fee|fine of)\\b"
        ],
        "ko": [
          "긴급|즉시|당장|급해|급한데|급하게|빠른시일내|24시간이내|최종(통보|경고|안내)",
          "오늘(까지|중으로)(?!.{0,10}(만나|보자|올게|갈게))",
          "(정지|차단|체포|구속|처벌|과태료|벌금|압류|고발).{0,6}(됩니다|될수|예정|처리|조치)",
          "미납.{0,10}(시|경우|가산)"
        ]
      },
      "explanation": {
        "en": "Pushes you to act fast or threatens a penalty, arrest or a blocked account. Pressure is a scammer's main tool. Real organizations give you time to check."
      },
      "needs_native_review": true
    },
    {
      "id": "secrecy",
      "category": "urgency",
      "weight": 3,
      "patterns": {
        "en": [
          "\\b(don'?t|do not|never) (tell|inform|contact) (anyone|your family|the bank|bank staff|police|others)\\b",
          "\\b(keep (this|it) (a )?(secret|confidential)|confidential investigation)\\b"
        ],
        "ko": [
          "(아무에게도|누구에게도|가족에게도|가족한테도|은행에|은행직원에게).{0,6}(말하지|알리지|말씀하지|얘기하지)",
          "비밀(수사|유지)"
        ]
      },
      "explanation": {
        "en": "Tells you to keep it secret from your family, bank or the police. Scammers do this so nobody can warn you."
      },
      "needs_native_review": true
    },
    {
      "id": "upfront_fee_job",
      "category": "job",
      "weight": 4,
      "patterns": {
        "en": [
          "\\b(registration|training|deposit|processing|admin|application|activation|membership|guarantee) (fee|deposit|payment)\\b",
          "\\b(pay|deposit|top[- ]?up|recharge)\\b.{0,30}\\b(first|before you start|to start|to unlock|to withdraw)\\b"
        ],
        "ko": [
          "(가입비|교육비|보증금|등록비|등록금|수수료|충전금).{0,10}(입금|선입금|먼저|필요|내셔야)",
          "선입금",
          "(출금|정산).{0,10}(하려면|위해).{0,10}(입금|충전)"
        ]
      },
      "explanation": {
        "en": "Asks you to pay a fee or deposit before you can work or get paid. Real jobs don't charge you to start."
      },
      "needs_native_review": true
    },
    {
      "id": "easy_money_job",
      "category": "job",
      "weight": 2,
      "patterns": {
        "en": [
          "\\b(earn|make|get paid)\\b.{0,30}\\b(per|a|every) (day|hour|task|order)\\b",
          "\\b(part[- ]time|work from home|side job|simple task|easy task)s?\\b.{0,60}\\b(pay|paid|earn|income|commission|daily)\\b",
          "\\b(like|follow|review|rate) (videos|posts|products|hotels)\\b.{0,40}\\b(earn|pay|paid|commission)\\b",
          "\\bno experience (needed|required)\\b.{0,60}\\b(earn|pay|₩|krw|won|\\$)",
          "\\b(add|contact) (me|us) on (telegram|whatsapp)\\b"
        ],
        "ko": [
          "고수익",
          "일당.{0,4}\\d",
          "재택(알바|부업|근무).{0,20}(수익|수당|일당|만원)",
          "(좋아요|리뷰|구독|팔로우).{0,10}(알바|부업|수익|수당)",
          "텔레그램.{0,10}(추가|연락|문의)"
        ]
      },
      "explanation": {
        "en": "Promises easy money for simple online tasks or moves you to Telegram or WhatsApp. These \"task jobs\" usually end with asking for your money."
      },
      "needs_native_review": true
    },
    {
      "id": "mixed_language",
      "category": "language",
      "weight": 1,
      "detector": "mixed_language",
      "patterns": {},
      "explanation": {
        "en": "Mixes Korean and English. Scam texts aimed at foreigners often do this. Real messages can too, so this alone means little."
      },
      "needs_native_review": true
    }
  ]
}
